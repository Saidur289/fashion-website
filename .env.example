APP_NAME=SafeBuy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =====================================================================
# SafeBuy shop settings — FILL THESE IN WITH THE CLIENT'S REAL DETAILS
# Every value below has a safe default. Empty values hide that item on the site.
# After changing .env on the live server, clear the config cache if it was cached.
# =====================================================================

# ---- Shop details (footer, emails, SMS) ----
SAFEBUY_EMAIL=safebuy70@gmail.com
SAFEBUY_ADDRESS="Jhenaidah, Bangladesh"
# Shown as "Call us" in the footer. Example: "01XXXXXXXXX"
SAFEBUY_PHONE=
# Shown as "Open Hours" in the footer. Example: "Sat–Thu, 10am–8pm"
SAFEBUY_HOURS=

# Homepage "Under Tk X" section limit (Taka)
SAFEBUY_BUDGET_LIMIT=1000

# ---- Delivery charges (Taka) ----
SHIPPING_INSIDE_DHAKA=70
SHIPPING_OUTSIDE_DHAKA=130
# Districts charged the inside-Dhaka rate, comma separated (names as in config/districts.php)
SHIPPING_INSIDE_DISTRICTS=Dhaka
# Free delivery when the order (after coupon) is at least this much. 0 = never free.
SAFEBUY_FREE_SHIPPING=3000
# Let customers collect from the shop for free (true/false)
SHIPPING_PICKUP_ENABLED=false
SHIPPING_PICKUP_ADDRESS="Jhenaidah, Bangladesh"

# ---- Payment ----
PAYMENT_COD_ENABLED=true
# bKash appears at checkout only when BKASH_NUMBER is filled in.
BKASH_ENABLED=true
# The bKash number customers pay to, e.g. 01XXXXXXXXX
BKASH_NUMBER=
# personal = "Send Money", agent = "Cash Out", merchant = "Payment"
BKASH_ACCOUNT_TYPE=personal

# ---- New-order alerts for the shop owner ----
# Email that receives every new order (needs the MAIL_* settings above)
ORDER_NOTIFY_EMAIL=
# Mobile that gets an SMS for every new order (needs the SMS settings below)
ORDER_NOTIFY_PHONE=

# ---- SMS gateway (order SMS to customers) ----
# log  = do not send, only write the SMS to storage/logs/laravel.log (safe default)
# http = send through the gateway below (BulkSMSBD, SSL Wireless, Alpha SMS, etc.)
SMS_DRIVER=log
# Gateway API address from the SMS provider, e.g. http://bulksmsbd.net/api/smsapi
SMS_HTTP_URL=
# GET or POST, as the provider's docs say
SMS_HTTP_METHOD=GET
# Query/body fields. {api_key} {sender_id} {to} {message} are filled in automatically.
# Change the field names to match the provider's docs.
SMS_HTTP_PARAMS="api_key={api_key}&senderid={sender_id}&number={to}&message={message}"
SMS_API_KEY=
SMS_SENDER_ID=

# ---- Email (order receipts) ----
# For real emails set MAIL_MAILER=smtp and fill MAIL_HOST, MAIL_PORT, MAIL_USERNAME,
# MAIL_PASSWORD and MAIL_FROM_ADDRESS above (e.g. the cPanel email account details).

# ---- Customer reviews ----
# false = new reviews wait for the shop owner's approval; true = publish at once
REVIEWS_AUTO_APPROVE=false
# Password-reset emails for customer accounts also use the MAIL_* settings above.

